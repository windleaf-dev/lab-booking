# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交
#   PowerShell: Copy-Item .env.example .env
#   docker compose up -d --build
#
# 注意：DB_PASSWORD 与 JWT_SECRET 为必填项。
# 未设置或留空时，docker compose 会直接报错退出，不再使用内置默认值。

# MySQL root 密码（同时用于后端连接），必填
DB_PASSWORD=

# JWT 签名密钥，必填，至少 32 字符
# 生成示例：
#   openssl rand -base64 48
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_})
JWT_SECRET=

# 前端访问端口（宿主机），可选，默认 8080
FRONTEND_PORT=8080
