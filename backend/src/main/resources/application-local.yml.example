# 本地敏感配置示例
#
# 使用：
#   Copy-Item application-local.yml.example application-local.yml
#   然后填写真实的 MySQL 口令和 JWT 密钥
#
# application-local.yml 已被 .gitignore 排除，不会提交到仓库。
# 也可以用环境变量 DB_PASSWORD / JWT_SECRET 代替。

spring:
  datasource:
    password: "your-mysql-password"

app:
  jwt:
    # 至少 32 个字符的随机字符串，可用 openssl rand -base64 48 生成
    secret: "replace-with-a-random-secret-at-least-32-chars"
